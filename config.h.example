#pragma once

// Rename this file to config.h and adjust if needed.
//
// Unlike the rest of this fleet, this file has no per-device secrets in
// it -- WiFi, MQTT, and device identity are all configured at runtime via
// the built-in web setup portal (see README), not compiled in here. The
// same compiled firmware image works on every unit; only OTA_PASSWORD and
// AP_PASSWORD below are fleet-wide (not per-device) values you might want
// to change away from the shared default. Still gitignored for
// consistency with the rest of this fleet, in case you ever add something
// sensitive to it.

// ------------------------------------------------------------------
// Device identity (firmware facts, not user settings)
// ------------------------------------------------------------------
static const char* DEVICE_MANUFACTURER = "P@cho";
static const char* DEVICE_MODEL        = "TH-4";
static const char* DEVICE_HW_VERSION   = "1.0";
static const char* FIRMWARE_VERSION    = "4.0.0";

// ------------------------------------------------------------------
// OTA (ArduinoOTA, Arduino IDE "Network Port")
// ------------------------------------------------------------------
static const char* OTA_PASSWORD = "changeme-ota";

// ------------------------------------------------------------------
// Setup portal
// ------------------------------------------------------------------
// Password for this device's own temporary setup WiFi network (e.g.
// "P@cho TH-2 XXXX"). MUST be 8-63 characters -- that's a hard WPA2
// requirement, not just this library's preference. Under 8 characters and
// WiFi.softAP() fails to bring the AP up AT ALL, with no visible error --
// the network just never appears, which looks identical to a crash. (The
// firmware detects this and falls back to an open network rather than
// failing silently, but don't rely on that -- just use 8+ characters here,
// or set to "" for an intentionally open network.) It's only broadcast
// while the portal is open, not during normal operation.
static const char* AP_PASSWORD = "setup1234";
// How long the setup portal stays open before giving up and going back to
// sleep with whatever settings it already had.
static const uint32_t PORTAL_TIMEOUT_SEC = 600; // 10 min

// Setup button hold thresholds. Released before BUTTON_OTA_HOLD_MS: not a
// deliberate hold, normal cycle. Held past that but released before
// BUTTON_SETUP_HOLD_MS: OTA-only window (no portal), LED solid on. Held
// past BUTTON_SETUP_HOLD_MS: full setup portal, LED pulsing briefly every
// SETUP_LED_BLINK_PERIOD_MS (on for SETUP_LED_PULSE_MS, off the rest --
// a quick heartbeat blip, not a 50/50 on/off blink) -- committed to the
// instant the hold crosses that mark, without waiting for release.
static const uint32_t BUTTON_OTA_HOLD_MS   = 2000;  // 2s
static const uint32_t BUTTON_SETUP_HOLD_MS = 10000; // 10s
static const uint32_t SETUP_LED_BLINK_PERIOD_MS = 500; // 0.5s between pulses
static const uint32_t SETUP_LED_PULSE_MS        = 50;  // each pulse's on-time

// While the setup portal is open, holding the button again for this long
// wipes the device's saved settings and the ESP32 radio's own persisted
// WiFi credentials, then restarts unconfigured -- a factory reset, done
// entirely by hold gesture rather than through the web page.
static const uint32_t FACTORY_RESET_HOLD_MS = 5000; // 5s

// ------------------------------------------------------------------
// Hardware pins (ESP32-C3 -- same wiring as temp_humidity_sensor)
// ------------------------------------------------------------------
static const gpio_num_t SENSOR_POWER_PIN = GPIO_NUM_3;
static const gpio_num_t LED_PIN          = GPIO_NUM_7;
static const gpio_num_t BATT_PIN         = GPIO_NUM_1;
static const int SDA_PIN                 = 4;
static const int SCL_PIN                 = 5;
// Hold at boot: opens the setup portal, then a following OTA window.
static const gpio_num_t SETUP_PIN        = GPIO_NUM_0;

// Status LED brightness, driven via LEDC PWM instead of a plain digital
// on/off so it can be dimmed. 100 = full brightness. This is only the
// initial default for a never-configured device -- the live value is
// runtime-adjustable via the "LED Brightness" number entity in Home
// Assistant (settings.ledBrightnessPct, persisted in NVS), so changing
// this afterward has no effect on an already-configured unit.
static const uint8_t LED_BRIGHTNESS_PCT = 100;
static const uint32_t LED_PWM_FREQ_HZ   = 5000;
static const uint8_t LED_PWM_RESOLUTION = 8; // 0-255
static const uint16_t LED_PWM_MAX_DUTY  = (1 << LED_PWM_RESOLUTION) - 1;

// ------------------------------------------------------------------
// Battery calibration -- device-specific. Defaults to identity (no
// correction); measure this board's own raw-vs-actual voltage (multimeter
// on the battery, compare against the raw value logged over serial) and
// replace these before trusting precise battery %.
// ------------------------------------------------------------------
static const float BATT_DIVIDER_RATIO = 2.0f;
static const int BATT_ADC_SAMPLES = 16;
struct CalPoint { float raw; float actual; };
static const CalPoint BATT_CAL[] = {
  {3.00f, 3.00f}, {4.20f, 4.20f},
};
static const int BATT_CAL_POINTS = sizeof(BATT_CAL) / sizeof(BATT_CAL[0]);
static const float BATTERY_LOW_THRESHOLD_PCT = 15.0f;
// The last-full-charge diagnostic (see updateAndGetLastFullChargeDate() in
// the .ino) only re-arms once the battery reads at or below this -- avoids
// recording a "new" full charge every time a reading hovering near the top
// of the curve bounces back up to 100%, when it was never really any lower
// than this.
static const float FULL_CHARGE_REARM_THRESHOLD_PCT = 97.0f;
static const float TEMP_OFFSET_C = 0.0f;

// ------------------------------------------------------------------
// Timing
// ------------------------------------------------------------------
// DEFAULT sleep interval between readings (10 min). The live value is chosen
// from HA ("Update Interval" select) and persisted in NVS -- this is only
// what a fresh/factory-reset device starts with. expire_after in the HA
// discovery configs is derived from the chosen interval (3x), not set here.
static const uint64_t SLEEP_INTERVAL_US = 10ULL * 60 * 1000000ULL;
static const uint32_t OTA_WINDOW_MS = 5UL * 60 * 1000UL;
static const uint32_t AWAKE_WATCHDOG_TIMEOUT_MS = 90UL * 1000UL;
static const uint32_t WIFI_CONNECT_TIMEOUT_MS = 8000;
static const uint32_t MQTT_CONNECT_TIMEOUT_MS = 5000;
static const uint32_t MQTT_ACK_TIMEOUT_MS = 1500;
static const uint8_t MQTT_PUBLISH_RETRIES = 3;
static const uint32_t SENSOR_POWER_SETTLE_MS = 100;
static const char* NTP_SERVER = "pool.ntp.org";
static const uint32_t NTP_SYNC_TIMEOUT_MS = 5000;
static const uint32_t NTP_RESYNC_EVERY_N_BOOTS = 6;
static const bool DEBUG_MODE = false;
static const uint32_t DEBUG_BOOT_DELAY_MS = 5000;
